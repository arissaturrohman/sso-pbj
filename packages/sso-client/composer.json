{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pemkab-demak/sso-client",
    "description": "Klien SSO OAuth2 (Authorization Code + PKCE) untuk aplikasi-aplikasi Pemkab Demak.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Demak\\SsoClient\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Demak\\SsoClient\\SsoClientServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
